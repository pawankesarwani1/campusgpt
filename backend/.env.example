# ─────────────────────────────────────────────────────────────
# CampusGPT backend — environment template
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Google AI Studio API key — get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# MongoDB connection string (local default, or a MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=campusgpt

# JWT settings — generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ChromaDB persistence directory (relative to the backend folder)
CHROMA_PERSIST_DIR=../chroma_store
