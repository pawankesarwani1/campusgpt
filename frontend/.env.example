# ─────────────────────────────────────────────────────────────
# CampusGPT frontend — environment template
# Copy to ".env" for local dev, or set these in your host (Vercel).
# ─────────────────────────────────────────────────────────────

# Public URL of the backend API.
# Local dev: leave unset (defaults to http://127.0.0.1:8000)
# Production: set to your deployed backend, e.g. https://campusgpt-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000
