{
  "name": "campusgpt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CampusGPT — AI Study Assistant for Anna University",
  "author": "CampusGPT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "electron:preview": "vite build && cross-env FORCE_PROD=1 electron electron/main.cjs",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "jspdf": "^2.5.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.24.0",
    "react-syntax-highlighter": "^15.5.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "in.campusgpt.desktop",
    "productName": "CampusGPT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CampusGPT"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
